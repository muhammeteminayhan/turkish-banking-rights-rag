# Copy to .env and fill in. Never commit .env.

# --- LLM provider (used from M4) ---
# ollama | gemini | anthropic. If gemini or anthropic is selected but no credential is
# found, the app falls back to ollama and says so in the logs.
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Qwen3 reasons before answering unless 0: slower (p50 27 s vs 18 s per question) but
# clearly more accurate in the M4 smoke runs.
OLLAMA_THINK=
# Context window, default 8192: the largest Ollama keeps wholly on an 8 GB GPU (a larger
# one moves layers to the CPU and runs ~2x slower).
OLLAMA_NUM_CTX=
# cpu | cuda: where bge-m3 and the reranker run when answering. Keep cpu on a GPU that
# cannot hold them next to the language model (8 GB is not enough): sharing it
# slows Ollama down, and on a busy GPU questions time out.
RETRIEVAL_DEVICE=cpu
OLLAMA_MODEL=qwen3:8b

# Gemini, free tier (optional judge or comparison model; LLM_PROVIDER=gemini to answer).
# Free only when the key's Google project has NO billing account; on the free tier Google
# may use the content to improve its products. Limits: see AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
# Requests per minute the client allows itself (default 5).
GEMINI_RPM=

# --- Database (used from M3) ---
# docker-compose.yml publishes the db on 127.0.0.1:5433 (POSTGRES_PORT). Use the IP:
# "localhost" may try IPv6 first and wait for a timeout.
DATABASE_URL=postgresql://finhak:finhak@127.0.0.1:5433/finhak

# --- Data collection (M1) ---
# Minimum seconds between two requests to the same host (brief: at most 1 req/s).
FETCH_MIN_INTERVAL_SECONDS=1.1
